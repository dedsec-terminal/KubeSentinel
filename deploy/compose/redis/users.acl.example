# Redis ACL Configuration Template
# Generated by: python scripts/kubesentinel.py bootstrap-local
# The actual users.acl file is generated locally into deploy/compose/redis/users.acl and ignored by Git.

user default off
user producer on >change-me-producer-password resetkeys ~security-events resetchannels -@all +auth +ping +xadd
user consumer on >change-me-consumer-password resetkeys ~security-events resetchannels -@all +auth +ping +xreadgroup +xack
user bootstrap on >change-me-bootstrap-password resetkeys ~security-events resetchannels -@all +auth +ping +xgroup +xinfo +xpending
