# KubeSentinel Local Compose Environment Configuration Template
# Copy to .env.local or generate via: python scripts/kubesentinel.py bootstrap-local

# Redis ACL Authentication Credentials
# Generated cryptographically random passwords for least-privilege users
REDIS_PRODUCER_PASSWORD=change-me-producer-password
REDIS_CONSUMER_PASSWORD=change-me-consumer-password
REDIS_BOOTSTRAP_PASSWORD=change-me-bootstrap-password

# Redis Connection Details
# Internal Docker Compose service hostname (zero host exposure)
REDIS_HOST=redis
REDIS_PORT=6379

# Redis Stream & Consumer Group Configuration
REDIS_STREAM=security-events
REDIS_CONSUMER_GROUP=edge-workers

# Edge Infrastructure Context Metadata
EDGE_SITE=pune
NAMESPACE=local-compose
SERVICE=edge-api
